<Window x:Class="Rngic.Demo.Windows.WindowMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rngic.Demo.Windows"
        mc:Ignorable="d"
        Title="Rngic" Height="450" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid VerticalAlignment="Top" Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输入图片:" Grid.Column="0"/>
            <TextBox x:Name="textbox_inputPath" IsReadOnly="True" Grid.Column="1" Margin="10,0,10,0"/>
            <Button x:Name="button_inputBrowse" Content="浏览..." MinWidth="50" Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="密码:" Grid.Column="0"/>
            <TextBox x:Name="textbox_passwd" Grid.Column="1" Margin="10,0,0,0"/>
        </Grid>

        <Grid Background="Gainsboro" Grid.Row="2" Margin="0,0,0,10">
            <Image x:Name="image_preview"/>
        </Grid>


        <Grid x:Name="grid_opBtns" MinHeight="25" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="button_confuse" Content="混淆" Grid.Column="0" Margin="0,0,5,0"/>
            <Button x:Name="button_deconfuse" Content="反混淆" Grid.Column="1" Margin="5,0,0,0"/>
            <Button x:Name="button_save" Content="保存..." Grid.Column="2" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>
